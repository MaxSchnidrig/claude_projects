# Classic algorithms written in Lumen

fn quicksort(items) {
    if len(items) <= 1 { return items; }
    let pivot = items[0];
    let smaller = [];
    let larger = [];
    for i in range(1, len(items)) {
        if items[i] < pivot {
            push(smaller, items[i]);
        } else {
            push(larger, items[i]);
        }
    }
    return quicksort(smaller) + [pivot] + quicksort(larger);
}

fn binary_search(items, target) {
    let low = 0;
    let high = len(items) - 1;
    let steps = 0;
    while low <= high {
        steps += 1;
        let middle = floor((low + high) / 2);
        if items[middle] == target { return [middle, steps]; }
        if items[middle] < target {
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
    return [-1, steps];
}

fn primes_up_to(limit) {
    # Sieve of Eratosthenes
    let is_prime = [false, false] + [true] * (limit - 1);
    let p = 2;
    while p * p <= limit {
        if is_prime[p] {
            let multiple = p * p;
            while multiple <= limit {
                is_prime[multiple] = false;
                multiple += p;
            }
        }
        p += 1;
    }
    let primes = [];
    for n in range(limit + 1) {
        if is_prime[n] { push(primes, n); }
    }
    return primes;
}

fn gcd(a, b) {
    if b == 0 { return a; }
    return gcd(b, a % b);
}

fn hanoi(disks, from, to, spare, moves) {
    if disks == 0 { return moves; }
    hanoi(disks - 1, from, spare, to, moves);
    push(moves, from + "->" + to);
    hanoi(disks - 1, spare, to, from, moves);
    return moves;
}

let data = [38, 27, 43, 3, 9, 82, 10, 3, 55];
let sorted = quicksort(data);
print("quicksort:", sorted);

let big = range(0, 100000, 3);
let found = binary_search(big, 29997);
print("binary search found 29997 at index", found[0], "in", found[1], "steps");

print("primes up to 50:", primes_up_to(50));
print("gcd(1071, 462) =", gcd(1071, 462));

let moves = hanoi(3, "A", "C", "B", []);
print("towers of hanoi with 3 disks takes", len(moves), "moves:", join(moves, " "));
